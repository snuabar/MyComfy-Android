<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TableRow>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCopyPrompt"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="复制提示词" />

            <Button
                android:id="@+id/btnCopySeed"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="复制种子" />

            <Button
                android:id="@+id/btnCopyImage"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="复制图像" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnDownloadAgain"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="重新下载" />

            <Button
                android:id="@+id/btnDelete"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="删除" />

            <Button
                android:id="@+id/btnDeleteAssociated"
                style="@style/ButtonBorderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关联删除" />

        </LinearLayout>
    </TableRow>

</TableLayout>